<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F5F7FA">

    <!-- Título Principal (Mismo estilo que el login) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textColor="#0D47A1"
        android:textSize="42sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Subtítulo de la pantalla -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/monitor_title"
        android:textColor="#1976D2"
        android:textSize="18sp"
        android:textStyle="normal"
        android:layout_marginBottom="48dp"/>

    <!-- Tarjeta central para el monitor de BPM -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp">

            <!-- Número gigante (0) al centro -->
            <TextView
                android:id="@+id/tvBpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/initial_bpm_value"
                android:textColor="#0D47A1"
                android:textSize="120sp"
                android:includeFontPadding="false"
                android:textStyle="bold" />

            <!-- Texto BPM justo debajo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bpm_label"
                android:textColor="#1976D2"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Estado de la conexión / sensor (Estilo botón no clicable) -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_connecting"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/bg_status_rounded"
        android:layout_marginTop="10dp"/>

</LinearLayout>